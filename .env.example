# Copy to .env and fill in. NEVER put real values in this file: it is tracked,
# and the repository is public. `npm test` fails if a credential lands here.

# ── Jira Cloud ──────────────────────────────────────────────────────────────
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Comma-separated Jira project keys to watch for learning topics.
JIRA_PROJECTS=LEARN

# ── Trigger ─────────────────────────────────────────────────────────────────
# A topic is picked up when it is an Epic, carries this label, AND sits in
# this status. Both are required, so a half-written topic never fires.
TRIGGER_LABEL=autolearn
TRIGGER_STATUS=Ready for AI
POLL_INTERVAL_MS=30000

# ── Planner ─────────────────────────────────────────────────────────────────
# Runs on your Claude subscription via `claude -p`. No API key is used.
PLANNER_MODEL=opus
# Let the planner search the web so resource links are real and current.
WEB_RESEARCH=true
MAX_STORIES=12
MAX_SUBTASKS_PER_STORY=6
STEP_TIMEOUT_MS=1200000       # 20 min wall clock per plan
MAX_PLANS_PER_DAY=20

LOG_LEVEL=info

# ── DANGER ──────────────────────────────────────────────────────────────────
# Intentionally NOT set. The runner strips it from the child environment and
# refuses `--bare`, so nothing here can bill an API key.
# ANTHROPIC_API_KEY=
